# Required for the contact form (client-side, so PUBLIC_ prefix)
PUBLIC_WEB3FORMS_ACCESS_KEY=your-web3forms-access-key
RESEND_API_KEY=your-resend-api-key

# Shared secret for the /api/enquiry liveness probe. The external uptime monitor
# sends this as `token` alongside `type: "healthcheck"`. Without it the probe
# returns 503, so the check fails loudly rather than running unauthenticated.
HEALTHCHECK_TOKEN=generate-with-openssl-rand-base64-24
